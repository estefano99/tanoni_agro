---
import { Image } from "astro:assets";
import Logo from "../images/logo.png";
import { Mail, MessageCircleMore, Phone } from "lucide-react";

const { lang } = Astro.props;
---

<footer class="bg-white dark:bg-gray-900">
  <div class="mx-auto w-full max-w-screen-2xl p-4 py-6 lg:py-8">
    <div class="md:flex md:justify-around">
      <div class="mb-6 md:mb-0 flex items-center gap-3">
        <Image src={Logo} class="h-8 w-8" alt="Tanoni Agro Logo" />
        <span class="text-2xl font-semibold dark:text-white">Tanoni Agro</span>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">

        <!-- Responsable General -->
        <div class="space-y-1">
          <h3 class="text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "Responsable General" : "General Manager"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Monica Scarpeccio</p>
          <a href="mailto:monica.scarpeccio@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> monica.scarpeccio@tanoniagro.com.ar
          </a>
          <a href="https://wa.me/5493416468744" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 341 6468744
          </a>
        </div>

        <!-- Comercial Granos y Subproductos -->
        <div class="space-y-1">
          <h3 class="text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "COMERCIAL CEREALES Y OLEAGINOSAS" : "COMMERCIAL CEREALS AND OILSEEDS"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Darío Orsetti</p>
          <a href="mailto:dario.orsetti@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> dario.orsetti@tanoniagro.com.ar
          </a>
          <a href="https://wa.me/5493412859466" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 3142 859466
          </a>
        </div>

        <!-- Comercial Aceites -->
        <div class="space-y-1">
          <h3 class="text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "COMERCIAL ACEITES Y SUB PRODUCTOS" : "COMMERCIAL OILS AND BY-PRODUCTS"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Carola Tanoni</p>
          <a href="mailto:carola.tanoni@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> carola.tanoni@tanoniagro.com.ar
          </a>
          <a href="https://wa.me/5493465650857" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 3465 650857
          </a>
        </div>
        
        <!-- Comercial externo -->
        <div class="space-y-1">
          <h3 class="text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "Comercial externo" : "External Sales"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">José Zapico</p>
          <!-- <a href="mailto:jose.zapico@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> jose.zapico@tanoniagro.com.ar
          </a> -->
          <a href="https://wa.me/5493401646041" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 3401 646041
          </a>
        </div>

        <!-- Comercial externo -->
        <div class="space-y-1">
          <h3 class="block md:hidden text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "COMERCIAL CEREALES Y OLEAGINOSAS" : "COMMERCIAL CEREALS AND OILSEEDS"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Diego Travella</p>
           <a href="mailto:diego.travella@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> diego.travella@tanoniagro.com.ar
          </a>
          <a href="https://wa.me/5493412129882" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 341 2129882
          </a>
        </div>

        <!-- Administración y Logística -->
        <div class="space-y-1">
          <h3 class="text-sm font-semibold text-gray-900 uppercase dark:text-white mb-4">
            {lang === "es" ? "Administración y Logística" : "Administration and Logistics"}
          </h3>
          <p class="text-gray-500 dark:text-gray-400 font-medium">Adrian Vazquez</p>
          <a href="mailto:adrian.vazquez@tanoniagro.com.ar" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <Mail /> adrian.vazquez@tanoniagro.com.ar
          </a>
          <a href="https://wa.me/5493417194513" target="_blank" class="flex gap-2 hover:underline text-gray-500 dark:text-gray-400">
            <MessageCircleMore /> +54 9 341 7194513
          </a>
        </div>

      </div>
    </div>

    <hr class="my-6 border-gray-200 dark:border-gray-700 lg:my-8" />
    <div class="text-center">
      <span class="text-sm text-gray-500 dark:text-gray-400 spanFechaActual"></span>
    </div>
  </div>
</footer>

<script is:inline>
  const fechaActual = new Date().getFullYear();
  const spanFechaActual = document.querySelector(".spanFechaActual");
  document.addEventListener("DOMContentLoaded", () => {
    spanFechaActual.textContent = `© ${fechaActual} Tanoni Agro. Todos los derechos reservados.`;
  });
</script>
